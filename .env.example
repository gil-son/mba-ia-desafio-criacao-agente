# Chave do Google AI Studio — obrigatória
GOOGLE_API_KEY=

# Modelo usado pelo agente principal (orquestrador)
# Exemplos: gemini-3.5-flash-lite, gemini-3.5-flash
MODEL_PRINCIPAL=gemini-3.5-flash-lite

# Modelo usado pelo especialista de reservas e visitantes
MODEL_ESPECIALISTA_RESERVAS=gemini-3.5-flash-lite

# Modelo usado pelo especialista de regulamento
MODEL_ESPECIALISTA_REGULAMENTO=gemini-3.5-flash-lite
